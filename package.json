{
  "name": "password-management-service-api",
  "version": "1.0.0",
  "description": "Password Management Service API built with Koa, TypeScript, PostgreSQL, and Docker",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "dotenv -e .env.local -- ts-node-dev --respawn --transpile-only src/index.ts",
    "test:unit": "jest -c jest.unit.config.js",
    "test:watch": "jest -c jest.unit.config.js --watch",
    "test:integration": "tsc && jest -c jest.integration.config.js",
    "test:docker:integration": "jest -c jest.integration.config.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "migrate:create": "node-pg-migrate create -m migrations",
    "migrate:up": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations",
    "migrate:up:local": "dotenv -e .env.local -- node-pg-migrate up -m migrations",
    "migrate:down:local": "dotenv -e .env.local -- node-pg-migrate down -m migrations",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:test": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit"
  },
  "keywords": [
    "password-management",
    "koa",
    "typescript",
    "postgresql",
    "docker",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^5.1.1",
    "koa-helmet": "^7.0.2",
    "pg": "^8.13.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/koa": "^2.13.12",
    "@types/koa__router": "^12.0.0",
    "@types/koa-bodyparser": "^4.3.11",
    "@types/koa-compress": "^4.0.7",
    "@types/koa__cors": "^5.0.0",
    "@types/pg": "^8.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^9.0.7",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "node-pg-migrate": "^7.6.1",
    "dotenv-cli": "^7.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
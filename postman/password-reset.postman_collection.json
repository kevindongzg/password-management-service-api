{
  "info": {
    "name": "Password Reset Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "00000000-0000-0000-0000-000000000000"
  },
  "item": [
    {
      "name": "Initiate Password Reset",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-correlation-id", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/password-reset/initiate",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "initiate"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user1@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Initiate returns resetId and code', function () {",
              "  pm.expect(json).to.have.property('resetId');",
              "  pm.expect(json).to.have.property('code');",
              "  pm.expect(json).to.have.property('expiresAt');",
              "});",
              "pm.collectionVariables.set('code', json.code);",
              "pm.collectionVariables.set('resetId', json.resetId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Execute Password Reset",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-correlation-id", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/password-reset/execute",
          "host": ["{{baseUrl}}"],
          "path": ["password-reset", "execute"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user1@example.com\",\n  \"code\": \"{{code}}\",\n  \"newPassword\": \"NewPass123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Execute returns success message', function () {",
              "  pm.expect(json).to.have.property('message', 'Password updated successfully');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "code", "value": "" },
    { "key": "resetId", "value": "" }
  ]
}
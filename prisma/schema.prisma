generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id
  email         String                 @unique
  password_hash String
  is_active     Boolean                @default(true)
  created_at    DateTime               @default(now()) @db.Timestamptz(6)
  updated_at    DateTime               @default(now()) @db.Timestamptz(6)
  resetRequests PasswordResetRequest[]

  @@map("users")
}

model PasswordResetRequest {
  id         String    @id
  userId     String    @map("user_id")
  email      String
  code       String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_user")

  @@index([email, code], map: "password_reset_requests_email_code_index")
  @@index([email, expires_at], map: "password_reset_requests_email_expires_at_index")
  @@index([userId, expires_at], map: "password_reset_requests_user_id_expires_at_index")
  @@map("password_reset_requests")
}

model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}

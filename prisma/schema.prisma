generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @db.Text
  email          String   @unique @db.Text
  password_hash  String   @db.Text
  is_active      Boolean  @default(true)
  created_at     DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz
  updated_at     DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz

  resetRequests  PasswordResetRequest[]

  @@map("users")
}

model PasswordResetRequest {
  id          String    @id @db.Text
  userId      String    @map("user_id") @db.Text
  email       String    @db.Text
  code        String    @db.Text
  expires_at  DateTime  @db.Timestamptz
  used_at     DateTime? @db.Timestamptz
  created_at  DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires_at])
  @@index([email, code])
  @@index([email, expires_at])
  @@map("password_reset_requests")
}